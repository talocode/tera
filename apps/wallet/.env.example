# Public browser configuration. Do not put private keys, seed phrases, or passcodes here.
# Production builds default to Solana mainnet. Dev server defaults to devnet
# unless VITE_SOLANA_CLUSTER is set.

# mainnet-beta | devnet
VITE_SOLANA_CLUSTER=devnet

# Optional RPC. Used only when VITE_SOLANA_CLUSTER matches the active network.
# A devnet URL will not be used after you switch to mainnet.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Official $TCODE mint on Solana mainnet. Do not change unless Talocode publishes a new mint.
VITE_TCODE_MINT=6ptxwABxQz8zMhwhiPeVgRgWjGMdVcEBFBv8v8C3ory
